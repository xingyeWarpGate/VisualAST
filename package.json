{
  "name": "vast-cli-plugin",
  "version": "0.1.0",
  "description": "VAST 2.2.1 typed visual compiler CLI and Agent Plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vast": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/plugin/tools.js",
    "./plugin/dsh": "./dist/plugin/dsh/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "regression": "npm run build && node dist/regression/runner.js",
    "doctor": "npm run build && node dist/cli/main.js doctor --json",
    "test:221": "npm run build && node --test tests-221/core.test.mjs",
    "smoke": "npm run build && node dist/cli/main.js version"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
